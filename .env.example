# Copier vers `.env` (non versionné). Préfixe VITE_ obligatoire : ces valeurs sont injectées
# dans le bundle et déterminent quelle base Supabase le site interroge (une seule source).
#
# Vercel / hébergeur : uniquement le jour où tu déploies le site en ligne. En local, le .env suffit.
# Quand tu brancheras un hébergeur, reprends les MÊMES trois variables dans son interface (env du build).
#
# 1) Identifiant projet (Dashboard → Settings → General → Reference ID)
VITE_SUPABASE_PROJECT_ID=
#
# 2) URL du projet — prioritaire si renseignée (sinon : https://{PROJECT_ID}.supabase.co)
VITE_SUPABASE_URL=
#
# 3) Clé anon (Dashboard → Settings → API → anon public)
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optionnel : autres emails autorisés pour /admin (OTP), séparés par des virgules
# VITE_ADMIN_ALLOWED_EMAILS=

# ---------------------------------------------------------------------------
# Configuration SMTP pour l'envoi d'emails (réinitialisation mot de passe, etc.)
# ---------------------------------------------------------------------------
# Service d'email : 'smtp' (Brevo) ou 'resend'
EMAIL_SERVICE=smtp

# Configuration SMTP Brevo (recommandé)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=af01e7001@smtp-brevo.com
SMTP_PASS=xsmtpsib-e12ca668c08d853e002cded512d904bbe1f0818a30ed3b4c7a2193b094f57b38-CjMmnGbFQ3XlcxrX
EMAIL_FROM=Malakinfo <no-reply@malakinfo.com>

# Alternative : Resend
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Configuration Stripe (paiements en ligne)
# ---------------------------------------------------------------------------
# Clé publique (pour le frontend)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Clé secrète (pour le backend - ne jamais exposer)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Webhook secret (pour vérifier les événements Stripe)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# PostgreSQL + formulaire /admission (API locale server/admission-api.mjs)
# ---------------------------------------------------------------------------
# DATABASE_URL : lue par db:ping, pg-ping, et l’API admission (INSERT public.students).
# Local : ex. Postgres sur la machine
# DATABASE_URL=postgresql://upg_admin:VOTRE_MOT_DE_PASSE@localhost:5432/site_upg_db
#
# Port de l’API admission (défaut 8787 — doit correspondre au proxy dans vite.config.ts)
# ADMISSION_API_PORT=8787
#
# Développement : lancer Vite + API en parallèle
#   npm run dev:all
# (sinon : un terminal `npm run dev:server` + un autre `npm run dev`)
#
# Build / hébergement statique : l’API doit tourner sur un serveur ; indiquer son origine :
# VITE_ADMISSION_API_BASE=https://votre-api.example.com

# ---------------------------------------------------------------------------
# Ne pas mettre ici : RESEND_API_KEY, SERVICE_ROLE → Secrets Edge Function newsletter
# ---------------------------------------------------------------------------
