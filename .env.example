# API Node native : CockroachDB reste la source de vérité.
DATABASE_URL=
APP_URL=https://system.upgoma.org
APP_PUBLIC_URL=https://www.upgoma.org

# Brevo SMTP pour les emails transactionnels.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Université Polytechnique de Goma

# Cloudflare R2. R2_ENDPOINT peut être https://<account-id>.r2.cloudflarestorage.com.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=upg-admissions
R2_ENDPOINT=
R2_PUBLIC_URL=

# Le site principal peut appeler les routes publiques d'admission/newsletter.
# Le système est sur la même origine que les routes /api/auth/*.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:8081,http://localhost:4173,https://upgoma.org,https://www.upgoma.org,https://system.upgoma.org
TRUST_PROXY_HOPS=0
ADMISSION_API_PORT=8787

# Configuration Stripe (si le paiement en ligne est activé).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# En production, inclure deploy/nginx/admission-api-location.conf dans le
# virtual host HTTPS de system.upgoma.org pour relayer /api/* vers 127.0.0.1:8787.
# Le frontend Vite utilise le proxy /api vers ce même port en développement.
